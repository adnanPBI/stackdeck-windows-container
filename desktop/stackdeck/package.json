{
  "name": "stackdeck",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "tauri": "tauri",
    "build:hive": "cargo build -p stackdeck-cli --bin stackdeck-hive --release --target x86_64-pc-windows-msvc --locked",
    "stage:hive": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stage-hive.ps1",
    "build:desktop-release": "tauri build --no-bundle --ci --target x86_64-pc-windows-msvc",
    "verify:desktop-release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-release-binary.ps1",
    "bundle:windows": "tauri bundle --bundles msi,nsis --ci --target x86_64-pc-windows-msvc",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/windows/09-Build-Signed-Release.ps1",
    "package:windows:unsigned": "npm run build:hive && npm run stage:hive && npm run build:desktop-release && npm run verify:desktop-release && npm run bundle:windows"
  },
  "dependencies": {
    "@tauri-apps/api": "2.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.5.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.4.5",
    "vite": "^8.1.5"
  }
}
